# Copy this file to .env and fill in whichever keys you actually have:
#
#   cp .env.example .env
#
# Every key here is optional. Any stage whose key is missing falls back to
# its free mock automatically (see README.md), so the pipeline always runs
# end to end even with .env empty or missing entirely.

# TypeSafe AI — powers real triage (Jev's Choice/Score/Noul judgment).
# Get one at https://console.typesafe.ai/keys
# TYPESAFE_API_KEY=

# Anthropic — powers real brief generation (Sonnet), and also drives the
# browser-use extraction agent if you opt into EXTRACT_PROVIDER=browser-use
# below (that's a separate use of the same key, not a separate key).
# ANTHROPIC_API_KEY=

# Extraction stays on the mock sample data even if ANTHROPIC_API_KEY is set
# above — a live 3-site crawl takes ~30-90s and spends several LLM calls, so
# it needs this explicit opt-in rather than piggybacking on a key set for
# generation. Uncomment to turn on real browser-use extraction:
# EXTRACT_PROVIDER=browser-use

# browser-use runs headless (no visible window) by default, which is the
# normal way to run it. Set this to false to watch a real Chrome window
# navigate the three sources live instead of trusting the log output.
# BROWSER_USE_HEADLESS=false

# Force a specific provider regardless of which keys are set above.
# Values: "mock" or the real provider name ("typesafe" / "claude" /
# "browser-use" as appropriate). Leave commented to use the default logic.
# TRIAGE_PROVIDER=mock
# GENERATE_PROVIDER=mock
